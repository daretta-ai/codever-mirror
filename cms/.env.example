# Chiave usata da Payload per firmare token/cookie: in produzione usare un valore lungo e casuale
PAYLOAD_SECRET=change-me-in-production

# Connessione SQLite (default: file locale nella root del progetto cms)
DATABASE_URI=file:./codever.db

# URL pubblico del CMS (usato da Payload per link assoluti)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Origin del frontend autorizzati per CORS/CSRF (separati da virgola)
FRONTEND_URL=http://localhost:3001
